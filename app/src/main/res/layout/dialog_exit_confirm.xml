<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_surface"
    android:gravity="center_horizontal"
    android:minWidth="440dp"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginBottom="14dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_launcher_cat" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/exit_confirm_title"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/exit_confirm_message"
        android:textColor="@color/text_secondary"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_exit_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_cancel_button"
            android:focusable="true"
            android:nextFocusLeft="@+id/btn_exit_cancel"
            android:nextFocusRight="@+id/btn_exit_confirm"
            android:nextFocusUp="@+id/btn_exit_cancel"
            android:nextFocusDown="@+id/btn_exit_cancel"
            android:text="@string/exit_confirm_cancel"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_exit_confirm"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_confirm_button"
            android:focusable="true"
            android:nextFocusLeft="@+id/btn_exit_cancel"
            android:nextFocusRight="@+id/btn_exit_confirm"
            android:nextFocusUp="@+id/btn_exit_confirm"
            android:nextFocusDown="@+id/btn_exit_confirm"
            android:text="@string/exit_confirm_ok"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
