<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/browse_bg">

    <!-- 左侧红色装饰条 -->
    <View
        android:layout_width="6dp"
        android:layout_height="match_parent"
        android:background="@color/accent" />

    <!-- 居中内容块 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- App 名 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:text="@string/app_name"
            android:textColor="#E0E0E0"
            android:textSize="52sp" />

        <!-- 分隔线 -->
        <View
            android:layout_width="80dp"
            android:layout_height="3dp"
            android:layout_marginTop="12dp"
            android:background="@color/accent" />

        <!-- 提示文字 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/onboard_hint"
            android:textColor="#9E9E9E"
            android:textSize="22sp" />

        <!-- 打开设置按钮 -->
        <LinearLayout
            android:id="@+id/onboard_action_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:background="@color/primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_settings_gear" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/onboard_action"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 按键提示 -->
        <TextView
            android:id="@+id/onboard_key_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/onboard_key_hint"
            android:textColor="#616161"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- 右上角标题 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_margin="32dp"
        android:text="@string/browse_title"
        android:textColor="#BDBDBD"
        android:textSize="22sp" />

</RelativeLayout>
