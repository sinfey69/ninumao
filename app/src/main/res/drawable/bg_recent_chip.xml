<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#2A3247" />
            <stroke android:width="2.5dp" android:color="@color/focus_ring" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#323B54" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A1E2B" />
            <stroke android:width="1dp" android:color="#2D354A" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
